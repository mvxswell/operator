# Public Supabase settings for the leaderboard.
# Leave both unset to hide the leaderboard. The build still passes.
# Never put the service-role key in this file or in the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Set to 1 to preview the leaderboard with local sample rows.
# Ignored when the two Supabase variables above are both set.
# NEXT_PUBLIC_LEADERBOARD_STUB=1
