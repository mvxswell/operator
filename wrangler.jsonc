{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "think-operator-presence",
  "main": "worker/presence.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "PRESENCE", "class_name": "Presence" }]
  },
  "exports": {
    "Presence": { "type": "durable-object", "storage": "sqlite" }
  },
  "ratelimits": [
    { "name": "PRESENCE_RATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]
}
